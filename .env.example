# Пример переменных окружения. Реальные секреты не коммитить.

# --- docker compose (необязательно, есть безопасные dev-значения по умолчанию) ---
POSTGRES_USER=todo
POSTGRES_PASSWORD=change_me
POSTGRES_DB=todo

# --- backend (запуск без Docker) ---
DATABASE_URL=postgresql://todo:change_me@localhost:5432/todo?schema=public
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# true, если backend доступен по HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# --- тесты backend (отдельная БД, имя должно содержать "test") ---
TEST_DATABASE_URL=postgresql://todo_test:todo_test@localhost:5433/todo_test?schema=public

# --- frontend (запуск без Docker) ---
VITE_API_URL=http://localhost:3001
